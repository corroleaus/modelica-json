{"@context":{"S231":"http://data.ashrae.org/S231#","qudt":"http://qudt.org/schema/qudt#","unit":"http://qudt.org/vocab/unit#","ex":"http://example.org#"},"@graph":[{"@id":"ex:FromModelica.StringParameters","@type":"S231:Block","S231:description":"String parameters keep their quotes; a unit comes from a literal or from a parameter","S231:hasInput":[{"@id":"ex:FromModelica.StringParameters.uLit"},{"@id":"ex:FromModelica.StringParameters.uRef"}],"S231:hasOutput":{"@id":"ex:FromModelica.StringParameters.y"},"S231:hasParameter":[{"@id":"ex:FromModelica.StringParameters.compoundUnit"},{"@id":"ex:FromModelica.StringParameters.isBoolean"},{"@id":"ex:FromModelica.StringParameters.notABoolean"},{"@id":"ex:FromModelica.StringParameters.quantityUnit"},{"@id":"ex:FromModelica.StringParameters.unitAlias"}],"S231:label":"StringParameters"},{"@id":"ex:FromModelica.StringParameters.compoundUnit","@type":"S231:Parameter","S231:accessSpecifier":"public","S231:description":"A literal that looks like a division","S231:isOfDataType":{"@id":"S231:String"},"S231:label":"compoundUnit","S231:value":"\"kg/s\""},{"@id":"ex:FromModelica.StringParameters.isBoolean","@type":"S231:Parameter","S231:accessSpecifier":"public","S231:description":"A real Boolean","S231:isOfDataType":{"@id":"S231:Boolean"},"S231:label":"isBoolean","S231:value":true},{"@id":"ex:FromModelica.StringParameters.notABoolean","@type":"S231:Parameter","S231:accessSpecifier":"public","S231:description":"A literal that spells a Boolean","S231:isOfDataType":{"@id":"S231:String"},"S231:label":"notABoolean","S231:value":"\"true\""},{"@id":"ex:FromModelica.StringParameters.quantityUnit","@type":"S231:Parameter","S231:accessSpecifier":"public","S231:description":"A string literal","S231:isOfDataType":{"@id":"S231:String"},"S231:label":"quantityUnit","S231:value":"\"W\""},{"@id":"ex:FromModelica.StringParameters.uLit","@type":"S231:RealInput","S231:accessSpecifier":"public","S231:description":"Unit from a literal","S231:isConnectedTo":